# Cabeceras para Netlify y Cloudflare Pages. Otros hosts las ignoran; si
# despliegas en Nginx o Apache hay que traducirlas a su configuración.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # 'wasm-unsafe-eval' es obligatorio: el decodificador Draco es WebAssembly y
  # sin él el navegador no puede instanciarlo, así que el personaje no carga.
  # blob: en connect-src e img-src también: GLTFLoader extrae las texturas del
  # GLB a URLs blob: y las pide con fetch.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Los ficheros con hash en el nombre no cambian nunca: se cachean para siempre.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/models/*
  Cache-Control: public, max-age=31536000, immutable
# El decodificador Draco va versionado con three y no cambia nunca, pero está
# en la ruta crítica: sin él ningún GLB se puede leer. Sin esta regla se
# revalidaba en cada visita.
/assets/draco/*
  Cache-Control: public, max-age=31536000, immutable
/index.html
  Cache-Control: no-cache
